						"description": "Gửi yêu cầu đăng ký chứng thư số mới cho người dân."
					},
					"response": []
				},
				{
					"name": "05. Tra cứu kết quả đăng ký CCTS",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
