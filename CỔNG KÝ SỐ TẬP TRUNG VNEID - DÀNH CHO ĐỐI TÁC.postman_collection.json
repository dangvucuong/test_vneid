{
	"info": {
		"_postman_id": "1f80f8bb-fbab-4e0d-a107-884be58dcf95",
		"name": "CỔNG KÝ SỐ TẬP TRUNG VNEID - DÀNH CHO ĐỐI TÁC",
		"description": "Collection mẫu hỗ trợ Đối tác/Đơn vị khai thác tích hợp và test kết nối qua Gateway Trung gian.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "I. XÁC THỰC & TÀI KHOẢN",
			"item": [
				{
					"name": "01. Authenticate - Lấy Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"    console.log('Lưu Token thành công!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"CA2\",\n  \"password\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"token"
							]
						},
						"description": "Đăng nhập hệ thống để lấy Access Token và Refresh Token."
					},
					"response": []
				},
				{
					"name": "02. Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Cấp lại Access Token khi hết hạn phiên làm việc."
					},
					"response": []
				}
			]
		},
		{
			"name": "II. DANH MỤC & CẤU HÌNH",
			"item": [
				{
					"name": "03. Lấy DS Nhà cung cấp & Gói dịch vụ",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json; charset=utf-8"
							},
							{
								"key": "X-Request-Id",
								"value": "{{$guid}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/providers",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"providers"
							]
						},
						"description": "Lấy danh sách các nhà cung cấp CA và các gói dịch vụ khả dụng."
					},
					"response": []
				}
			]
		},
		{
			"name": "III. NGHIỆP VỤ ĐĂNG KÝ CHỨNG THƯ SỐ",
			"item": [
				{
					"name": "04. Đăng ký chứng thư chữ ký số",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.transactionCode) {",
									"    pm.collectionVariables.set('transactionCode', jsonData.data.transactionCode);",
									"    console.log('Lưu mã transactionCode:', jsonData.data.transactionCode);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json; charset=utf-8"
							},
							{
								"key": "X-Request-Id",
								"value": "35716e9b-e8bd-45e7-a121-7af3893e604b",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userInfo\": {\n    \"fullName\": \"Đặng Mỹ Ngọc\",\n    \"birthDate\": \"18/10/2001\",\n    \"citizenPid\": \"054098006041\",\n    \"issuingAuthority\": \"Cục Cảnh sát quản lý hành chính về trật tự xã hội\",\n    \"dateOfIssue\": \"01/01/2025\",\n    \"gender\": \"Nữ\",\n    \"phone\": \"0936543210\",\n    \"email\": \"ngoc.dm@example.com\",\n    \"nationalityCode\": \"VN\",\n    \"permanentAddress\": \"888 Trần Hưng Đạo\",\n    \"permanentVillageText\": \"Phường Cửa Nam\",\n    \"permanentCityText\": \"Thành phố Hà Nội\",\n    \"livingPlaceAddress\": \"888 Trần Hưng Đạo\",\n    \"livingPlaceVillageText\": \"Phường Cửa Nam\",\n    \"livingPlaceCityText\": \"Thành phố Hà Nội\",\n    \"idCardExpireDate\": \"01/01/2035\"\n  },\n  \"provider\": \"HUD-VNPT-SMARTCA\",\n  \"servicePackCode\": \"VNEID-FREE-6M\",\n  \"originatorCode\": \"vuhv123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/certificates/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
