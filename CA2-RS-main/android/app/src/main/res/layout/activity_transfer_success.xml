<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background_gradient_dark">

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="?actionBarSize"
        style="@style/Text.Title"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/transaction_success"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textSize="@dimen/_14sdp"
        android:id="@+id/tv_success" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_success"
        app:layout_constraintBottom_toTopOf="@id/btn_go_home">
        <LinearLayout
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_amount_value"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="@dimen/_21sdp"
                android:gravity="center"
                android:text="20,000,000 VND" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_description_amount"
                android:layout_marginVertical="@dimen/_5sdp"
                android:gravity="center"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/silver"
                android:textSize="@dimen/_12sdp"
                android:text="Hai mươi triệu đồng" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_time_transfer"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:gravity="center"
                android:text="15:15 - 22/02/2024" />
            <LinearLayout
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:text="@string/transaction_info" />
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Body"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="@dimen/_11sdp"
                    android:text="@string/beneficiary_info" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sdp"
                    style="@style/Text.Title"
                    android:textColor="@color/white"
                    android:text="38380000888888"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Body"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="@dimen/_11sdp"
                    android:text="@string/name_beneficiary" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sdp"
                    style="@style/Text.Title"
                    android:textColor="@color/white"
                    android:text="PHAM VAN VO"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Body"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="@dimen/_11sdp"
                    android:text="@string/transaction_code" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sdp"
                    style="@style/Text.Title"
                    android:textColor="@color/white"
                    android:text="88888888"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Body"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="@dimen/_11sdp"
                    android:text="@string/banking_name" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sdp"
                    style="@style/Text.Title"
                    android:textColor="@color/white"
                    android:text="BIDV - Ngân hàng Đầu tư và phát triển Việt Nam"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Body"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="@dimen/_11sdp"
                    android:text="@string/transaction_amount" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_subtitle_amount_value"
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sdp"
                    style="@style/Text.Title"
                    android:textColor="@color/white"
                    android:text="20,000,000 VND"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    style="@style/Text.Body"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="@dimen/_11sdp"
                    android:text="@string/content_transaction" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12sdp"
                    style="@style/Text.Title"
                    android:textColor="@color/white"
                    android:text="NGUYEN VAN A chuyen tien"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_marginStart="@dimen/_10sdp"
                    android:id="@+id/iv_original"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_100sdp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iv_face_ekyc"
                    android:scaleType="centerCrop" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title"
                    android:text="@string/image_chip"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@id/iv_original"
                    app:layout_constraintStart_toStartOf="@id/iv_original"
                    app:layout_constraintEnd_toEndOf="@id/iv_original"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textColor="@color/silver"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:id="@+id/iv_face_ekyc"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_100sdp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded"
                    app:layout_constraintEnd_toStartOf="@id/iv_face_live"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_original"
                    android:scaleType="centerCrop" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/silver"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title"
                    android:text="@string/image_selfie"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@id/iv_face_ekyc"
                    app:layout_constraintStart_toStartOf="@id/iv_face_ekyc"
                    app:layout_constraintEnd_toEndOf="@id/iv_face_ekyc"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:id="@+id/iv_face_live"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_100sdp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_face_ekyc"
                    android:scaleType="centerCrop" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/silver"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title"
                    android:text="@string/image_face_live"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@id/iv_face_live"
                    app:layout_constraintStart_toStartOf="@id/iv_face_live"
                    app:layout_constraintEnd_toEndOf="@id/iv_face_live"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        style="@style/Text.Title"
        android:layout_margin="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/btn_go_home"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textSize="@dimen/_12sdp"
        android:textAllCaps="true"
        android:layout_marginTop="30dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/success"
        android:text="@string/home_page" />
</androidx.constraintlayout.widget.ConstraintLayout>