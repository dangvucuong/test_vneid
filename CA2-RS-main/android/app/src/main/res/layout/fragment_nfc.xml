<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/colorPrimary">
    <include layout="@layout/layout_header" android:id="@+id/ll_header"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_anim_scan_id"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_210sdp"
        app:lottie_rawRes="@raw/nfc_scan"
        app:lottie_loop="true"
        app:lottie_autoPlay="true"
        android:layout_marginTop="@dimen/_50sdp"
        android:layout_below="@id/ll_header"
        android:layout_gravity="center"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_below="@id/lav_anim_scan_id"
        android:id="@+id/tv_nfc_instruction"
        style="@style/Text.Title"
        android:lines="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="@string/nfc_title"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp" />
    <com.airbnb.lottie.LottieAnimationView
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_nfc_instruction"
        android:id="@+id/lav_animation_loading"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_60sdp"
        app:lottie_rawRes="@raw/animation_loading"
        android:scaleType="centerCrop"
        app:lottie_loop="true"
        app:lottie_autoPlay="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:lottie_colorFilter="@color/white"/>
    <Button
        android:id="@+id/btn_start"
        style="@style/Text.Title"
        android:layout_margin="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:textSize="@dimen/_12sdp"
        android:textAllCaps="true"
        android:layout_marginTop="@dimen/_30sdp"
        android:textColor="@color/white"
        android:backgroundTint="@color/success"
        android:text="@string/button_title_begin" />

</RelativeLayout>