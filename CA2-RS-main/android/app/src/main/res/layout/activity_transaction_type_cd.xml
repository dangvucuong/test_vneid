<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_gradient_dark">

    <include
        android:id="@+id/l_header"
        layout="@layout/layout_header" />

    <ImageView
        android:id="@+id/iv_transfer_money"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_200sdp"
        android:src="@drawable/icon_transfer_money"
        app:layout_constraintTop_toBottomOf="@id/l_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_transaction_c"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="@string/transaction_type_c"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/white"
        android:textAllCaps="true"
        android:paddingHorizontal="@dimen/_12sdp"

        android:background="@drawable/bg_circle_transaction_type"
        app:layout_constraintTop_toBottomOf="@id/iv_transfer_money"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_transaction_d"/>
    <TextView
        android:id="@+id/tv_transaction_d"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="@string/transaction_type_d"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/white"
        android:textAllCaps="true"
        android:paddingHorizontal="@dimen/_12sdp"
        android:background="@drawable/bg_circle_transaction_type"
        app:layout_constraintTop_toBottomOf="@id/iv_transfer_money"
        app:layout_constraintStart_toEndOf="@id/tv_transaction_c"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>