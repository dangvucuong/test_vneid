<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_gradient_dark">

    <include
        android:id="@+id/lheader"
        layout="@layout/layout_header" />

    <FrameLayout
        android:layout_marginTop="@dimen/_10sdp"
        android:id="@+id/frag_container_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lheader"
        app:layout_constraintBottom_toTopOf="@id/btn_next"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_process_ocr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lheader"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        android:gravity="center">
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Text.Title"
            android:id="@+id/tv_step_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/loading"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_animation_loading"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_60sdp"
            app:lottie_rawRes="@raw/animation_loading"
            android:scaleType="centerCrop"
            app:lottie_colorFilter="@color/white"
            app:lottie_loop="true"
            app:lottie_autoPlay="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <Button
        android:id="@+id/btn_next"
        style="@style/Text.Title"
        android:layout_margin="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textSize="@dimen/_12sdp"
        android:textAllCaps="true"
        android:layout_marginTop="@dimen/_30sdp"
        android:textColor="@color/white"
        android:backgroundTint="@color/success"
        android:text="@string/button_title_continue" />

</androidx.constraintlayout.widget.ConstraintLayout>