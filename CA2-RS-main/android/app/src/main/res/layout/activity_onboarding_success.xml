<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background_gradient_dark">

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="?actionBarSize"
        style="@style/Text.Title"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/onboard_success"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textSize="@dimen/_14sdp"
        android:id="@+id/tv_success" />

    <com.google.android.material.card.MaterialCardView
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_success"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/mcv_face_match"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="@dimen/_1sdp"
        app:cardCornerRadius="@dimen/_5sdp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_60sdp"
                android:id="@+id/iv_original"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_110sdp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_face_live"
                android:scaleType="centerCrop" />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/image_chip"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/iv_original"
                app:layout_constraintStart_toStartOf="@id/iv_original"
                app:layout_constraintEnd_toEndOf="@id/iv_original"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textColor="@color/colorPrimary"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_60sdp"
                android:id="@+id/iv_face_live"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_110sdp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_original"
                android:scaleType="centerCrop" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/colorPrimary"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/image_selfie"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/iv_face_live"
                app:layout_constraintStart_toStartOf="@id/iv_face_live"
                app:layout_constraintEnd_toEndOf="@id/iv_face_live"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_onboarding_status"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:srcCompat="@drawable/ic_checkmark"
                app:tint="@color/success"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mcv_face_match"
        android:id="@+id/card_view_national_private_information"
        style="@style/CardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/margin_small"
        android:foreground="?android:selectableItemBackground"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="@dimen/_1sdp"
        app:cardCornerRadius="@dimen/_5sdp">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small"
            android:stretchColumns="1">
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/personal_info"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_eid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_eid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/label_document_number" />
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/value_pod_eid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/empty_na"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_fullname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_fullname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/full_name" />

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/value_pod_fullname"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/empty_na"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_dob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/dob" />

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/value_pod_dob"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/empty_na"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/gender" />

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/value_pod_gender"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/empty_na"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_place_of_residence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_place_of_residence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/place_of_residence" />

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/value_pod_place_of_residence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="3"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/empty_na"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2" />
            </TableRow>
            <TableRow
                android:id="@+id/row_a_systems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_a_systems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/eid_asystems_requirements" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/value_pod_a_systems"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:srcCompat="@drawable/ic_checkmark" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_verify_eid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_verify_eid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/eid_verification" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/value_pod_verify_eid"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:srcCompat="@drawable/ic_checkmark" />
            </TableRow>
            <TableRow
                android:id="@+id/row_pod_verify_face"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small">

                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="@font/google_sans_medium"
                    android:id="@+id/label_pod_verify_face"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="end"
                    android:padding="@dimen/margin_tiny"
                    android:text="@string/face_matching" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_marginStart="@dimen/_10sdp"
                    android:id="@+id/value_pod_verify_face"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="start|center_vertical"
                    app:srcCompat="@drawable/ic_checkmark"/>
            </TableRow>
        </TableLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:textSize="@dimen/_12sdp"
        android:layout_margin="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/success"
        android:textAllCaps="true"
        android:fontFamily="@font/google_sans_medium"
        android:textStyle="bold"
        android:text="@string/home_page" />

</androidx.constraintlayout.widget.ConstraintLayout>